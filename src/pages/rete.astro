---
import BaseLayout from '../layouts/BaseLayout.astro';
import universities from '../data/universities.json';
---
<BaseLayout title="Rete scientifica"><section class="page-hero"><div class="container-wide"><span class="eyebrow">Rete scientifica</span><h1>15 università consorziate.</h1><p>Esplora sedi, dipartimenti, delegati e afferenti. I dati derivano dall’archivio istituzionale corrente e potranno essere aggiornati direttamente dal pannello di gestione.</p></div></section><section class="section"><div class="container-wide"><div class="toolbar"><input class="field search" type="search" placeholder="Cerca università, dipartimento o afferente…" data-uni-search/></div><div class="university-grid" data-uni-grid>{universities.map(u=><details class="university-card" data-search={(u.name+' '+u.delegate+' '+u.departments.flatMap(d=>[d.name,...d.members]).join(' ')).toLowerCase()}><summary><div class="uni-top"><img src={u.logo} alt=""/><div><h3>{u.name}</h3><div class="delegate">Delegato: {u.delegate}</div></div></div></summary><div class="members">{u.departments.map(d=><div><h4>{d.name}</h4><ul>{d.members.map(m=><li>{m}{m===u.delegate?' · delegato':''}</li>)}</ul></div>)}</div></details>)}</div></div></section><script is:inline>const q=document.querySelector('[data-uni-search]');const cards=[...document.querySelectorAll('.university-card')];q?.addEventListener('input',()=>{const s=q.value.trim().toLowerCase();cards.forEach(c=>c.style.display=c.dataset.search.includes(s)?'':'none')});</script></BaseLayout>