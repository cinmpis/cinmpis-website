---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Contatti"><section class="page-hero"><div class="container-wide"><span class="eyebrow">Contatti</span><h1>Contatta il CINMPIS.</h1><p>Direzione, sede legale e riferimenti amministrativi del Consorzio.</p></div></section><section class="section"><div class="container-wide contact-grid"><div class="contact-box"><span class="meta">Direzione</span><h2>Prof. Vito Capriati</h2><p>Dipartimento di Farmacia – Scienze del Farmaco<br/>Università degli Studi di Bari Aldo Moro<br/>Campus Universitario “E. Quagliariello”<br/>Via E. Orabona, 4 – 70125 Bari</p><p><strong>Telefono:</strong> {site.phone}<br/><strong>Email:</strong> <a href={`mailto:${site.email}`} style="color:var(--blue)">{site.email}</a><br/><strong>PEC:</strong> <a href={`mailto:${site.pec}`} style="color:var(--blue)">{site.pec}</a></p></div><div class="contact-box"><span class="meta">Dati istituzionali</span><p><strong>Codice Fiscale</strong><br/>{site.cf}</p><p><strong>Partita IVA</strong><br/>{site.piva}</p><p><strong>Anagrafe Nazionale Ricerche</strong><br/>{site.anr}</p><p><strong>Sede legale</strong><br/>{site.legalAddress}</p></div></div></section></BaseLayout>