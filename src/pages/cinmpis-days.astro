---
import BaseLayout from '../layouts/BaseLayout.astro';
import events from '../data/events.json';
import { withBase } from '../utils/url.js';
const fmt=d=>new Date(d+'T12:00:00').toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric'});
const upcoming=events.find(e=>e.status==='upcoming');
const past=events.filter(e=>e.status!=='upcoming');
---
<BaseLayout title="CINMPIS Days"><section class="page-hero"><div class="container-wide"><span class="eyebrow">CINMPIS Days</span><h1>La comunità si incontra, ogni anno.</h1><p>Le Giornate Scientifiche del CINMPIS riuniscono ricercatrici, ricercatori e giovani scienziati della rete insieme a ospiti internazionali.</p></div></section><section class="section dark"><div class="container-wide">{upcoming && <div class="event-feature"><div class="event-date"><strong>15–17</strong>febbraio 2027</div><div><span class="meta">{upcoming.edition} edizione · {upcoming.city}</span><h2 style="font-size:2.2rem;margin:.3rem 0">CINMPIS Days 2027</h2><p style="color:#cbe0e4">{upcoming.venue}</p><p style="font-size:.8rem;color:#8fb5bd">Data e sede riportate dalla Società Chimica Italiana.</p></div></div>}</div></section><section class="section"><div class="container-wide"><div class="section-head"><div><span class="eyebrow">Archivio</span><h2>Edizioni precedenti</h2></div><p>Dal 2001 a oggi: sedi, date e CINMPIS Lecturers.</p></div><div class="timeline">{past.map(e=><article class="timeline-item"><div class="timeline-year">{e.start.slice(0,4)}</div><div><h3>{e.edition} · {e.city}</h3><p>{e.venue} · {fmt(e.start)}{e.end!==e.start?` – ${fmt(e.end)}`:''}</p>{e.website && <a class="link-arrow" href={e.website} target="_blank" rel="noopener">Sito dell’edizione</a>}</div>{e.lecturer && <div class="lecturer-chip">{e.lecturer.photo && <img src={withBase(e.lecturer.photo)} alt=""/>}<span><strong>CINMPIS Lecturer</strong><br/>{e.lecturer.name}<br/>{e.lecturer.affiliation}</span></div>}</article>)}</div></div></section></BaseLayout>
