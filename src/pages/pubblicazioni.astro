---
import BaseLayout from '../layouts/BaseLayout.astro';
import pubs from '../data/publications.json';
const years=[...new Set(pubs.map(p=>p.year).filter(Boolean))].sort((a,b)=>b-a);
---
<BaseLayout title="Pubblicazioni"><section class="page-hero"><div class="container-wide"><span class="eyebrow">Produzione scientifica</span><h1>Pubblicazioni.</h1><p>Archivio bibliografico del Consorzio. La nuova piattaforma è predisposta per l’importazione automatica via DOI/Crossref e per successive integrazioni ORCID.</p></div></section><section class="section"><div class="container-wide"><div class="toolbar"><input class="field search" type="search" placeholder="Titolo, autore, rivista o DOI…" data-pub-search/><select class="field" data-pub-year><option value="">Tutti gli anni</option>{years.map(y=><option value={y}>{y}</option>)}</select></div><p style="color:var(--muted);font-size:.86rem"><span data-count>{pubs.length}</span> record visualizzati · duplicati esatti rimossi durante la migrazione.</p><div data-pub-list>{pubs.map(p=><article class="list-card" data-pub data-year={p.year||''} data-text={(p.title+' '+p.authors+' '+p.journal+' '+p.doi).toLowerCase()}><span class="meta">{p.year} · {p.journal}</span><h3>{p.title}</h3><p>{p.authors}</p>{p.doi && <a class="doi" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">doi:{p.doi}</a>}</article>)}</div></div></section><script is:inline>const q=document.querySelector('[data-pub-search]'),yr=document.querySelector('[data-pub-year]'),ps=[...document.querySelectorAll('[data-pub]')],count=document.querySelector('[data-count]');function f(){const t=q.value.trim().toLowerCase(),y=yr.value;let n=0;ps.forEach(p=>{const on=(!t||p.dataset.text.includes(t))&&(!y||p.dataset.year===y);p.style.display=on?'':'none';if(on)n++});count.textContent=n}q?.addEventListener('input',f);yr?.addEventListener('change',f);</script></BaseLayout>