---
import BaseLayout from '../layouts/BaseLayout.astro';
import bandi from '../data/bandi.json';
const yearOf=s=>{const m=s.match(/(20\d{2})/);return m?m[1]:''};
---
<BaseLayout title="Bandi"><section class="page-hero"><div class="container-wide"><span class="eyebrow">Opportunità</span><h1>Bandi e borse di studio.</h1><p>Avvisi, borse di studio e bandi del Consorzio, con accesso all’archivio storico dei documenti originali.</p></div></section><section class="section"><div class="container-wide"><div class="toolbar"><input class="field search" type="search" placeholder="Cerca un bando…" data-search/><select class="field" data-year><option value="">Tutti gli anni</option>{[...new Set(bandi.map(b=>yearOf(b.date)))].filter(Boolean).sort().reverse().map(y=><option value={y}>{y}</option>)}</select></div><div data-list>{bandi.map(b=><article class="list-card" data-item data-searchable={(b.title+' '+b.description+' '+b.venue+' '+b.date).toLowerCase()} data-yearval={yearOf(b.date)}><span class="meta">Pubblicato il {b.date}</span><h3>{b.title}</h3><p>{b.description}</p>{b.venue && <p><strong>Sede:</strong> {b.venue}</p>}<p><strong>Scadenza:</strong> {b.deadline}</p><a class="link-arrow" href={b.attachment} target="_blank">Apri il PDF</a></article>)}</div></div></section><script is:inline>const s=document.querySelector('[data-search]'),y=document.querySelector('[data-year]'),items=[...document.querySelectorAll('[data-item]')];function f(){const q=s.value.toLowerCase(),yr=y.value;items.forEach(i=>i.style.display=(!q||i.dataset.searchable.includes(q))&&(!yr||i.dataset.yearval===yr)?'':'none')}s?.addEventListener('input',f);y?.addEventListener('change',f);</script></BaseLayout>