---
import site from '../data/site.json';
import { withBase } from '../utils/url.js';
const path = Astro.url.pathname;
const nav = [
  ['Il Consorzio','/consorzio/'],['Rete scientifica','/rete/'],['Organi','/organi/'],['CINMPIS Days','/cinmpis-days/'],['Premi','/premi/'],['Bandi','/bandi/'],['Pubblicazioni','/pubblicazioni/'],['Trasparenza','/amministrazione-trasparente/']
];
---
<header class="site-header" data-header>
  <div class="nav-wrap container-wide">
    <a class="brand" href={withBase('/')} aria-label="CINMPIS home">
      <span class="brand-logo"><img src={withBase(site.logo || '/assets/cinmpis-mark.svg')} alt="Logo CINMPIS" /></span>
      <span class="brand-copy"><strong>{site.name}</strong><small>{site.tagline || 'Rete interuniversitaria di ricerca'}</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Apri menu" aria-expanded="false" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" aria-label="Navigazione principale" data-main-nav>
      {nav.map(([label,href]) => {
        const resolved = withBase(href);
        return <a href={resolved} class={path.startsWith(resolved) ? 'active' : ''}>{label}</a>;
      })}
      <a href={withBase('/contatti/')} class="nav-cta">Contatti</a>
    </nav>
  </div>
</header>
<script is:inline>
  const btn=document.querySelector('[data-menu-toggle]'); const nav=document.querySelector('[data-main-nav]');
  btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true'; btn.setAttribute('aria-expanded',String(!open)); nav?.classList.toggle('open',!open);});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){btn?.setAttribute('aria-expanded','false');nav?.classList.remove('open')}});
</script>
