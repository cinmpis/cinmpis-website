---
import site from '../data/site.json';
import { withBase } from '../utils/url.js';
---
<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div>
      <div class="footer-brand"><span class="footer-logo"><img src={withBase(site.logo || '/assets/cinmpis-mark.svg')} alt="Logo CINMPIS"/></span><strong>CINMPIS</strong></div>
      <p>{site.fullName}</p>
      <p class="muted">Costituito nel 1994 · sotto la vigilanza del Ministero dell’Università e della Ricerca.</p>
    </div>
    <div><h3>Esplora</h3><a href={withBase('/consorzio/')}>Il Consorzio</a><a href={withBase('/rete/')}>Università consorziate</a><a href={withBase('/organi/')}>Organi</a><a href={withBase('/cinmpis-days/')}>CINMPIS Days</a></div>
    <div><h3>Risorse</h3><a href={withBase('/bandi/')}>Bandi</a><a href={withBase('/pubblicazioni/')}>Pubblicazioni</a><a href={withBase('/amministrazione-trasparente/')}>Amministrazione Trasparente</a><a href={withBase('/contatti/')}>Contatti</a></div>
    <div><h3>Contatti</h3><a href={`mailto:${site.email}`}>{site.email}</a><a href={`mailto:${site.pec}`}>{site.pec}</a><span>{site.phone}</span></div>
  </div>
  <div class="container-wide footer-bottom"><span>© {new Date().getFullYear()} CINMPIS</span><span>CF {site.cf} · P. IVA {site.piva}</span><span>Privacy · Accessibilità</span></div>
</footer>
