---
import site from '../data/site.json';
import { withBase } from '../utils/url.js';
---
<div class="hero-visual" aria-hidden="true">
  <div class="hero-orbit hero-orbit-a"></div>
  <div class="hero-orbit hero-orbit-b"></div>
  <svg class="molecular-field" viewBox="0 0 720 620" role="presentation">
    <defs>
      <linearGradient id="bond" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#94f1e4" stop-opacity=".18" />
        <stop offset=".55" stop-color="#7bd8e7" stop-opacity=".56" />
        <stop offset="1" stop-color="#ffffff" stop-opacity=".16" />
      </linearGradient>
      <radialGradient id="node" cx="32%" cy="28%" r="72%">
        <stop offset="0" stop-color="#dffeff" />
        <stop offset=".22" stop-color="#5bd5d1" />
        <stop offset="1" stop-color="#0a536a" />
      </radialGradient>
      <filter id="softGlow" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur stdDeviation="7" result="blur" />
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>
    <g class="bond-network" fill="none" stroke="url(#bond)" stroke-width="3">
      <path d="M92 188 L206 116 L316 190 L435 116 L552 184 L622 306 L548 427 L420 492 L305 422 L184 492 L92 405 Z" />
      <path d="M206 116 L184 492 M316 190 L548 427 M92 188 L305 422 M435 116 L420 492" opacity=".32"/>
      <path d="M316 190 L352 311 L305 422 M352 311 L552 184 M352 311 L92 405" opacity=".42"/>
    </g>
    <g filter="url(#softGlow)">
      <circle class="m-node n1" cx="92" cy="188" r="12" fill="url(#node)"/>
      <circle class="m-node n2" cx="206" cy="116" r="17" fill="url(#node)"/>
      <circle class="m-node n3" cx="316" cy="190" r="10" fill="url(#node)"/>
      <circle class="m-node n4" cx="435" cy="116" r="14" fill="url(#node)"/>
      <circle class="m-node n5" cx="552" cy="184" r="19" fill="url(#node)"/>
      <circle class="m-node n6" cx="622" cy="306" r="11" fill="url(#node)"/>
      <circle class="m-node n7" cx="548" cy="427" r="16" fill="url(#node)"/>
      <circle class="m-node n8" cx="420" cy="492" r="10" fill="url(#node)"/>
      <circle class="m-node n9" cx="305" cy="422" r="18" fill="url(#node)"/>
      <circle class="m-node n10" cx="184" cy="492" r="12" fill="url(#node)"/>
      <circle class="m-node n11" cx="92" cy="405" r="16" fill="url(#node)"/>
      <circle class="m-node n12" cx="352" cy="311" r="21" fill="url(#node)"/>
    </g>
    <g class="hex-traces" fill="none" stroke="#b5f5ef" stroke-opacity=".14" stroke-width="2">
      <path d="M520 72 567 99 567 153 520 180 473 153 473 99Z"/>
      <path d="M118 278 158 301 158 347 118 370 78 347 78 301Z"/>
      <path d="M487 298 524 319 524 362 487 383 450 362 450 319Z"/>
    </g>
  </svg>
  <img class="hero-logo-hex" src={withBase(site.logo || '/assets/cinmpis-mark.svg')} alt="" />
</div>
